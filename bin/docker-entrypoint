#!/usr/bin/env bash
set -e

# Prepare the database (create + migrate) before booting the server. The jobs
# container waits for web to become healthy, so only web runs this.
if [ "${1}" == "bin/rails" ] && [ "${2}" == "server" ]; then
  ./bin/rails db:prepare

  # Apply versioned data migrations (db/data, tracked in their own table and
  # safe to re-run). Non-fatal on purpose: a failing data migration must not take
  # the site down — it is logged loudly and retried on the next boot.
  if ! ./bin/rails data:migrate; then
    echo "[docker-entrypoint] WARNING: bin/rails data:migrate failed." >&2
    echo "[docker-entrypoint] The site will still boot; the migration is retried on the next restart." >&2
    echo "[docker-entrypoint] Inspect with: bin/rails data:migrate:status" >&2
  fi
fi

# OPENCODE_API_KEY is the whole credential: the v2 CLI reads it natively as an
# "environment" connection, and OpencodeCli inherits the container env. Do not
# write auth.json here — v2 keeps credentials in its own SQLite database and only
# imports that legacy file once, during the initial migration, so writing it does
# nothing on any volume that already booted.
#
# Two states are worth flagging, and neither may take the container down: the
# site works fine without summaries, so warn loudly and carry on.
#
#   1. The CLI cannot read its data directory (root-owned opencode_data volume
#      from an image built before the mount point existed).
#   2. A credential SAVED in the database takes precedence over the environment
#      connection, silently shadowing OPENCODE_API_KEY — key rotation then looks
#      successful while runs keep using the old key (HTTP 401, and the new key
#      stays "Last used: Never" in the Console).
if [ -n "${OPENCODE_API_KEY}" ]; then
  if accounts="$(timeout 15 opencode auth list 2>&1)"; then
    if printf '%s\n' "${accounts}" | awk 'NF >= 2 && $NF == "stored" { found = 1 } END { exit !found }'; then
      echo "[docker-entrypoint] WARNING: opencode has a credential saved in its database," >&2
      echo "[docker-entrypoint] and a saved account takes precedence over OPENCODE_API_KEY." >&2
      echo "[docker-entrypoint] Summaries will keep using that stale key. Remove it with:" >&2
      echo "[docker-entrypoint]   docker compose exec -it jobs opencode auth logout" >&2
    fi
  else
    echo "[docker-entrypoint] WARNING: 'opencode auth list' failed; the CLI cannot read" >&2
    echo "[docker-entrypoint] ${HOME}/.local/share/opencode. Summaries will fail until this" >&2
    echo "[docker-entrypoint] is fixed. ${HOME}/.local/share/opencode is probably root-owned," >&2
    echo "[docker-entrypoint] left over from an image built before the mount point existed." >&2
    echo "[docker-entrypoint] Recreate the volume with:" >&2
    echo "[docker-entrypoint]   docker compose down && docker volume rm <project>_opencode_data" >&2
    echo "[docker-entrypoint]   docker compose up --build" >&2
  fi
fi

exec "$@"
