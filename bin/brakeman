#!/usr/bin/env ruby
require "rubygems"
require "bundler/setup"

# `--ensure-latest` aborts with exit 5 (and no report) whenever the installed
# Brakeman is not the newest release, which silently disabled this scan. Pin the
# version in the Gemfile instead and run the analysis.
load Gem.bin_path("brakeman", "brakeman")
