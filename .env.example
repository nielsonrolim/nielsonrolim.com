# Copy to .env and fill in real values. Never commit .env.
#
# Loaded automatically in development by dotenv-rails. In production the same
# file is consumed by docker compose (`env_file: .env`). Restart bin/dev after
# editing — ENV is read at boot.

# --- Rails -------------------------------------------------------------------
# Contents of config/master.key (required to boot in RAILS_ENV=production).
RAILS_MASTER_KEY=replace_with_the_contents_of_config_master_key

# Comma-separated hosts allowed by the Host authorization filter.
RAILS_HOSTS=nielsonrolim.com,www.nielsonrolim.com

# Host port published by Docker Compose.
WEB_PORT=3000

# Time zone used by the recurring job schedule (Mondays 09:00 for the newsletter).
APP_TIME_ZONE=Brasilia
TZ=America/Sao_Paulo

# --- Admin area (HTTP Basic Auth) --------------------------------------------
# Required. The /admin area (reader + job dashboard) fails closed (403) if
# either is missing.
READER_USERNAME=
READER_PASSWORD=

# --- Newsletter email --------------------------------------------------------
# Public base URL used to build links inside emails.
APP_HOST=nielsonrolim.com
APP_PROTOCOL=https

# From: header for the weekly clipping.
NEWSLETTER_FROM=Nielson Rolim <newsletter@nielsonrolim.com>

# SMTP delivery. If SMTP_ADDRESS is blank, mail is written to tmp/mails instead
# of being sent.
#
# Development never sends for real, even with SMTP_* filled in, so a local run
# cannot email your real subscribers. It uses letter_opener by default, which
# renders the email under tmp/letter_opener and opens it in a browser.
#
# MAIL_DELIVERY overrides that: smtp | file | letter_opener
#   smtp          -> deliver for real (needs SMTP_ADDRESS)
#   file          -> write to tmp/mails, no browser tab
#   letter_opener -> development only
MAIL_DELIVERY=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
# plain | login | cram_md5
SMTP_AUTHENTICATION=plain

# --- AI summaries (opencode CLI) --------------------------------------------
# Free model used to summarize each clipping. List options with `opencode models`.
OPENCODE_SUMMARY_MODEL=opencode/ling-3.0-flash-fin-free
OPENCODE_SUMMARY_LANGUAGE=Brazilian Portuguese (pt-BR)

# Only used inside the container: bin/docker-entrypoint writes it to
# ~/.local/share/opencode/auth.json so the CLI is authenticated on boot.
# Locally, `opencode auth login` is enough and this can stay blank.
OPENCODE_API_KEY=

# --- Feed polling ------------------------------------------------------------
# How often a feed may be re-polled, in minutes.
FEED_REFRESH_MINUTES=30

# Solid Queue worker processes per container.
JOB_CONCURRENCY=1
