<%= NewsletterComposer.subject_for(@issue_date, locale: @locale) %>
<%= "=" * 60 %>

<%= t("newsletters.email.intro", count: @clippings.size, date: l(@issue_date.to_date, format: :long)) %>

<% if @clippings.empty? %>
<%= t("newsletters.email.empty") %>
<% else %>
<% @clippings.each_with_index do |clipping, index| %>
<%= format("%02d", index + 1) %>. <%= clipping.title_for(@locale) %>
<%= "    #{t('newsletters.email.source', feed: clipping.display_source)}" if clipping.display_source.present? %>
<%= "    #{t('newsletters.email.languages', list: clipping.languages.join(', '))}" if clipping.languages.any? %>
<% localized_summary = clipping.summary_for(@locale) %><%= "    #{localized_summary}" if localized_summary.present? %>
    <%= clipping.url_for(@locale) %>

<% end %>
<% end %>
--
