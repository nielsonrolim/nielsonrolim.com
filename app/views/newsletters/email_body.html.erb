<%# The archived issue content. Email clients strip <style> and external CSS, so
    every rule is inline. The per-recipient unsubscribe footer is appended by
    NewsletterMailer, because this body is stored once and reused for everyone. %>
<% ink = "#14110f"; muted = "#6b6560"; line = "#e4dfd7"; accent = "#b01e2d"; soft = "#3d3833" %>
<% mono = "'FiraCode Nerd Font', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f6f2;padding:24px 12px;font-family:<%= mono %>;color:<%= ink %>;font-size:15px;line-height:1.6;">
  <tr>
    <td align="center">
      <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;background:#ffffff;border:1px solid <%= line %>;border-radius:3px;">
        <tr>
          <td style="padding:20px 24px;border-bottom:1px solid <%= line %>;color:<%= muted %>;font-size:13px;">
            <span style="color:<%= accent %>;">$ </span>cat clipping-<%= @issue_date.strftime("%Y-%m-%d") %>.md
          </td>
        </tr>

        <tr>
          <td style="padding:24px;">
            <p style="margin:0 0 20px;color:<%= muted %>;font-size:14px;">
              <%= t("newsletters.email.intro", count: @clippings.size, date: l(@issue_date.to_date, format: :long)) %>
            </p>

            <% if @clippings.empty? %>
              <p style="margin:0;color:<%= muted %>;font-size:14px;"><%= t("newsletters.email.empty") %></p>
            <% else %>
              <% @clippings.each_with_index do |clipping, index| %>
                <div style="<%= index.positive? ? "border-top:1px solid #{line};padding-top:18px;margin-top:18px;" : "" %>">
                  <p style="margin:0 0 6px;font-size:12px;color:<%= muted %>;">
                    <%= format("%02d", index + 1) %><%= ". #{clipping.display_source}" if clipping.display_source.present? %><%= " · #{clipping.language}" if clipping.language.present? %>
                  </p>
                  <p style="margin:0 0 8px;font-size:16px;font-weight:700;">
                    <a href="<%= clipping.url_for(@locale) %>" style="color:<%= accent %>;text-decoration:underline;"><%= clipping.title_for(@locale) %></a>
                  </p>
                  <% localized_summary = clipping.summary_for(@locale) %>
                  <% if localized_summary.present? %>
                    <p style="margin:0 0 8px;font-size:14px;color:<%= soft %>;"><%= localized_summary %></p>
                  <% end %>
                  <p style="margin:0;font-size:12px;color:<%= muted %>;word-break:break-all;">
                    <a href="<%= clipping.url_for(@locale) %>" style="color:<%= muted %>;text-decoration:none;"><%= clipping.url_for(@locale) %></a>
                  </p>
                </div>
              <% end %>
            <% end %>
          </td>
        </tr>

        <tr>
          <td style="padding:20px 24px;border-top:1px solid <%= line %>;color:<%= muted %>;font-size:12px;">
            <span style="color:<%= accent %>;">nielson@nielsonrolim:~$</span>
            <%= t("newsletters.email.footer") %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
