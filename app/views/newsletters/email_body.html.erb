<%# The archived issue content. Email clients strip <style> and external CSS, so
    every rule is inline (the mailer layout carries the dark-mode overrides). The
    per-recipient unsubscribe footer is appended by NewsletterMailer, because this
    body is stored once and reused for everyone. %>
<% ink = "#14110f"; muted = "#6b6560"; line = "#e4dfd7"; accent = "#b01e2d"; soft = "#3d3833" %>
<% mono = "'FiraCode Nerd Font', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" %>
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f7f6f2;opacity:0;">
  <%= t("newsletters.email.preheader", count: @clippings.size) %>
  &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
</div>
<table class="email-shell" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f6f2;padding:24px 12px;font-family:<%= mono %>;color:<%= ink %>;font-size:16px;line-height:1.6;">
  <tr>
    <td align="center">
      <table class="email-card" role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;background:#ffffff;border:1px solid <%= line %>;border-radius:3px;">
        <tr>
          <td class="email-muted" style="padding:20px 24px;border-bottom:1px solid <%= line %>;color:<%= muted %>;font-size:13px;">
            <span class="email-accent" style="color:<%= accent %>;">$ </span>cat clipping-<%= @issue_date.strftime("%Y-%m-%d") %>.md
          </td>
        </tr>

        <tr>
          <td style="padding:24px;">
            <p class="email-muted" style="margin:0 0 20px;color:<%= muted %>;font-size:14px;">
              <%= t("newsletters.email.intro", count: @clippings.size, date: l(@issue_date.to_date, format: :long)) %>
            </p>

            <% if @clippings.empty? %>
              <p class="email-muted" style="margin:0;color:<%= muted %>;font-size:14px;"><%= t("newsletters.email.empty") %></p>
            <% else %>
              <% @clippings.each_with_index do |clipping, index| %>
                <div style="<%= index.positive? ? "border-top:1px solid #{line};padding-top:18px;margin-top:18px;" : "" %>">
                  <p class="email-muted" style="margin:0 0 6px;font-size:13px;color:<%= muted %>;">
                    <%= format("%02d", index + 1) %><%= ". #{clipping.display_source}" if clipping.display_source.present? %><%= " · #{clipping.languages.join(" · ")}" if clipping.languages.any? %>
                  </p>
                  <p style="margin:0 0 8px;font-size:16px;font-weight:700;">
                    <a class="email-accent" href="<%= safe_url(clipping.url_for(@locale)) %>" style="color:<%= accent %>;text-decoration:underline;"><%= clipping.title_for(@locale) %></a>
                  </p>
                  <% localized_summary = clipping.summary_for(@locale) %>
                  <% if localized_summary.present? %>
                    <p class="email-soft" style="margin:0 0 8px;font-size:14px;color:<%= soft %>;"><%= localized_summary %></p>
                    <% if clipping.partial_summary_source? %>
                      <p class="email-muted" style="margin:0 0 8px;font-size:13px;color:<%= muted %>;"><%= t("newsletters.email.partial_summary_source") %></p>
                    <% end %>
                  <% end %>
                  <p class="email-muted" style="margin:0;font-size:13px;color:<%= muted %>;word-break:break-all;">
                    <a class="email-muted" href="<%= safe_url(clipping.url_for(@locale)) %>" style="color:<%= muted %>;text-decoration:none;"><%= clipping.url_for(@locale) %></a>
                  </p>
                </div>
              <% end %>
            <% end %>
          </td>
        </tr>

        <tr>
          <td class="email-muted" style="padding:20px 24px;border-top:1px solid <%= line %>;color:<%= muted %>;font-size:13px;">
            <span class="email-accent" style="color:<%= accent %>;">nielson@nielsonrolim:~$</span>
            <%= t("newsletters.email.footer") %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
