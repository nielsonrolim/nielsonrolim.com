<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% page_title = content_for?(:title) ? yield(:title) : "#{t('pages.home.title')} — #{t('pages.home.role')}" %>
    <% page_description = content_for?(:description) ? yield(:description) : t('pages.home.bio') %>
    <% canonical = content_for?(:canonical) ? yield(:canonical) : "#{request.base_url}#{request.path}" %>
    <%# Each language has its own branded card, matching the page it shares. %>
    <% og_image = I18n.locale == :"en-US" ? "og-image-en.jpg" : "og-image.jpg" %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <% if content_for?(:robots) %><meta name="robots" content="<%= yield(:robots) %>"><% end %>
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#12110f" media="(prefers-color-scheme: dark)">
    <link rel="canonical" href="<%= canonical %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= t('pages.home.title') %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:locale" content="<%= I18n.locale.to_s.tr('-', '_') %>">
    <meta property="og:image" content="<%= "#{request.base_url}#{image_path(og_image)}" %>">
    <meta name="twitter:card" content="summary_large_image">
    <% if content_for?(:translated) %>
      <link rel="alternate" hreflang="pt-BR" href="<%= url_for(locale: "pt-BR", only_path: false) %>">
      <link rel="alternate" hreflang="en-US" href="<%= url_for(locale: "en-US", only_path: false) %>">
      <link rel="alternate" hreflang="x-default" href="<%= url_for(locale: "pt-BR", only_path: false) %>">
      <meta property="og:locale:alternate" content="<%= I18n.locale == :"pt-BR" ? "en_US" : "pt_BR" %>">
    <% end %>
    <%= render "layouts/theme_script" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-frame focus:border focus:border-line-stronger focus:bg-paper focus:px-4 focus:py-2 focus:text-ink"><%= t("shared.skip_to_content") %></a>

    <div id="toasts" class="toast-region" aria-live="polite" aria-atomic="true">
      <%= render "layouts/toasts" %>
    </div>

    <div class="mx-auto max-w-site px-6 pb-16 max-tiny:px-4.5 max-tiny:pb-12">
      <header class="mb-12 flex items-center justify-between gap-4 border-b border-line py-4.5 text-chrome text-muted">
        <span class="topbar__path"><%= t("shared.topbar_path") %></span>
        <div class="inline-flex items-center gap-3">
          <button type="button" data-theme-toggle aria-pressed="false" class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-frame border border-transparent text-muted hover:border-line-strong hover:text-ink" aria-label="<%= t("pages.home.theme_toggle") %>">
            <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <nav class="inline-flex items-center gap-2" aria-label="<%= t("pages.home.language_label") %>">
            <%= link_to "PT-BR", url_for(locale: "pt-BR"), class: "locale-switch__link", aria: { current: ("true" if I18n.locale == :"pt-BR") } %>
            <%= link_to "EN-US", url_for(locale: "en-US"), class: "locale-switch__link", aria: { current: ("true" if I18n.locale == :"en-US") } %>
          </nav>
        </div>
      </header>

      <main id="main" tabindex="-1">
        <%= yield %>
      </main>

      <footer class="mt-14 flex items-center gap-2 border-t border-line pt-6 text-chrome text-muted">
        <span class="terminal__prompt m-0" aria-hidden="true"></span>
        <span class="cursor inline-block h-[1.1em] w-[0.55em] animate-blink bg-ruby align-text-bottom motion-reduce:animate-none" aria-hidden="true"></span>
      </footer>
    </div>
  </body>
</html>
