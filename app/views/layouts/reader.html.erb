<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("reader.title") %> — nielsonrolim.com</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= render "layouts/theme_script" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="max-tiny:text-[15px]">
    <div class="mx-auto max-w-site px-6 pb-16 max-tiny:px-[1.1rem] max-tiny:pb-12">
      <header class="mb-10 border-b border-line py-[1.1rem]">
        <div class="flex items-center justify-between gap-4 text-chrome text-muted">
          <span class="topbar__path">~/reader</span>
          <button type="button" data-theme-toggle class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-frame border border-transparent text-muted hover:border-line-strong hover:text-ink" aria-label="<%= t("reader.theme_toggle") %>">
            <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>

        <nav class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-prompt" aria-label="<%= t("reader.nav.label") %>">
          <% [
               [ t("reader.nav.entries"), reader_entries_path, reader_entries_path ],
               [ t("reader.nav.clippings"), reader_clippings_path, reader_clippings_path ],
               [ t("reader.nav.feeds"), reader_feeds_path, reader_feeds_path ],
               [ t("reader.nav.newsletters"), reader_newsletters_path, reader_newsletters_path ]
             ].each do |label, path, active_path| %>
            <%= link_to label, path,
                  class: "no-underline text-muted hover:text-ink #{'text-ink font-bold' if request.path == active_path}",
                  aria: { current: request.path == active_path ? "page" : nil } %>
          <% end %>
          <%= link_to t("reader.nav.back_to_site"), home_path(locale: I18n.locale), class: "ml-auto text-chrome text-muted no-underline hover:text-ink" %>
        </nav>
      </header>

      <% flash.each do |type, message| %>
        <p class="flash flash--<%= type %>"><%= message %></p>
      <% end %>

      <main>
        <%= yield %>
      </main>

      <footer class="mt-14 flex items-center gap-2 border-t border-line pt-6 text-chrome text-muted">
        <span class="terminal__prompt m-0" aria-hidden="true"></span>
        <span class="cursor inline-block h-[1.1em] w-[0.55em] animate-blink bg-ruby align-text-bottom motion-reduce:animate-none" aria-hidden="true"></span>
      </footer>
    </div>
  </body>
</html>
