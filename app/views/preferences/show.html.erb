<section class="mt-2 max-w-measure">
  <p class="terminal__prompt mt-0 mb-[0.9rem] text-prompt font-bold text-ink"><%= t("preferences.show.prompt") %></p>
  <h1 class="mt-[0.1rem] mb-[0.9rem] text-lead font-bold text-ink"><%= t("preferences.show.title") %></h1>

  <p class="mb-6 text-prompt text-ink-soft">
    <%= t("preferences.show.body", email: @subscriber.email) %>
  </p>

  <%= form_with url: preferences_path(token: @subscriber.unsubscribe_token), method: :patch,
        scope: :subscriber, class: "grid gap-3" do |form| %>
    <div>
      <%= form.label :language, t("preferences.show.language_label"), class: "mb-1 block text-chrome text-muted" %>
      <%= form.select :language, Subscriber::LANGUAGES, { selected: @subscriber.language },
            class: "rounded-frame border border-line-strong bg-paper px-3 py-[0.35rem] font-mono text-form text-ink focus:border-ruby focus:outline-none" %>
      <p class="mt-1 mb-0 text-meta text-muted"><%= t("preferences.show.language_hint") %></p>
    </div>

    <%= form.submit t("preferences.show.save"),
          class: "justify-self-start cursor-pointer rounded-frame border border-line-strong bg-surface px-4 py-[0.4rem] font-mono text-form text-ruby hover:border-ruby" %>
  <% end %>

  <p class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-chrome">
    <%= link_to t("preferences.show.unsubscribe"), unsubscribe_path(token: @subscriber.unsubscribe_token), class: "text-muted" %>
    <%= link_to t("preferences.show.back"), home_path(locale: I18n.locale), class: "ml-auto text-muted" %>
  </p>
</section>
