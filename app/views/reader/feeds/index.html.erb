<section>
  <h1 class="mt-0 mb-3.5 text-prompt font-bold text-ink">
    <span class="terminal__prompt" aria-hidden="true"><%= t("reader.feeds.prompt") %></span>
    <span class="sr-only"><%= t("reader.feeds.title") %></span>
  </h1>

  <div class="mb-8 border border-line bg-surface p-4">
    <%= form_with model: @feed, url: reader_feeds_path, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div class="min-w-[16rem] flex-1">
        <%= form.label :url, t("reader.feeds.form.url"), class: "mb-1 block text-chrome text-muted" %>
        <%= form.url_field :url, required: true, placeholder: t("reader.feeds.form.url_placeholder"),
              class: "field focus:border-ruby" %>
      </div>
      <div class="min-w-[10rem]">
        <%= form.label :category, t("reader.feeds.form.category"), class: "mb-1 block text-chrome text-muted" %>
        <%= form.text_field :category, placeholder: t("reader.feeds.form.category_placeholder"),
              class: "field focus:border-ruby" %>
      </div>
      <%= form.submit t("reader.feeds.form.submit"),
            class: "btn btn--primary" %>
    <% end %>

    <div class="mt-3 flex items-center gap-3 text-chrome">
      <%= button_to t("reader.feeds.actions.refresh_all"), refresh_all_reader_feeds_path, method: :post,
            class: "btn btn--sm btn--neutral",
            form: { class: "m-0 inline" } %>
      <span class="text-muted"><%= t("reader.feeds.total", count: @feeds.size) %></span>
    </div>
  </div>

  <% filtering = @category.present? || @uncategorised %>
  <div class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 border-y border-line py-3 text-chrome">
    <span class="text-ruby"><%= t("reader.feeds.filters.category") %>:</span>
    <%= link_to t("reader.feeds.filters.all_categories"), reader_feeds_path,
          class: "no-underline #{filtering ? 'text-muted hover:text-ink' : 'font-bold text-ink'}" %>
    <% @categories.each do |category| %>
      <%= link_to category.name, reader_feeds_path(category_id: category.id),
            class: "no-underline #{@category&.id == category.id ? 'font-bold text-ink' : 'text-muted hover:text-ink'}" %>
    <% end %>
    <%= link_to t("reader.feeds.filters.uncategorized"), reader_feeds_path(uncategorised: 1),
          class: "no-underline #{@uncategorised ? 'font-bold text-ink' : 'text-muted hover:text-ink'}" %>
  </div>

  <% if @feeds.empty? %>
    <p class="text-prompt text-muted">
      <%= filtering ? t("reader.feeds.filters.empty") : t("reader.feeds.empty") %>
    </p>
  <% else %>
    <ol class="m-0 list-none p-0">
      <% @feeds.each do |feed| %>
        <li class="border-t border-line py-4.5 last:border-b">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 class="m-0 text-base font-bold text-ink"><%= feed.display_title %></h2>

            <%# The feed's own title, when the reader overrode it. %>
            <% if feed.custom_title.present? %>
              <span class="text-meta text-muted">(<%= feed.title %>)</span>
            <% end %>

            <% feed.categories.sort_by { |category| category.name.downcase }.each do |category| %>
              <span class="chip"><%= category.name %></span>
            <% end %>

            <span class="text-meta text-muted"><%= t("reader.feeds.entry_count", count: @entry_counts[feed.id].to_i) %></span>
          </div>

          <p class="mt-0.5 mb-1.5 text-meta">
            <%= link_to feed.url, safe_url(feed.url), target: "_blank", rel: "noopener noreferrer", class: "text-muted no-underline hover:text-ruby" %>
          </p>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-chrome text-muted">
            <span>
              <%= feed.fetched? ? t("reader.feeds.last_fetched", time: l(feed.last_fetched_at, format: :long)) : t("reader.feeds.never_fetched") %>
            </span>

            <% unless feed.healthy? %>
              <span class="text-err">
                <%= t("reader.feeds.error") %>: <%= truncate(feed.last_error.to_s, length: 90) %>
                <% if feed.last_error.to_s.length > 90 %>
                  <%# The full message lives behind a native disclosure instead of a
                      `title=` attribute, so it is reachable by keyboard and touch. %>
                  <details class="group inline-block align-top">
                    <summary class="cursor-pointer list-none text-ruby hover:text-ruby-ink">
                      <span class="group-open:hidden"><%= t("reader.feeds.error_more") %></span>
                      <span class="hidden group-open:inline"><%= t("reader.feeds.error_less") %></span>
                    </summary>
                    <span class="mt-1 block break-words"><%= feed.last_error %></span>
                  </details>
                <% end %>
              </span>
            <% end %>

            <span class="ml-auto flex items-center gap-3">
              <%= link_to t("reader.feeds.actions.edit"), edit_reader_feed_path(feed),
                    class: "btn btn--sm btn--neutral" %>
              <%= button_to t("reader.feeds.actions.refresh"), refresh_reader_feed_path(feed), method: :post,
                    class: "btn btn--sm btn--primary",
                    form: { class: "m-0 inline" } %>
              <%= button_to t("reader.feeds.actions.remove"), reader_feed_path(feed), method: :delete,
                    data: { confirm: t("reader.feeds.actions.confirm_remove", title: feed.display_title) },
                    class: "btn btn--sm btn--danger",
                    form: { class: "m-0 inline" } %>
            </span>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
