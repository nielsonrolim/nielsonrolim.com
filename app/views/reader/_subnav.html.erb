<%# Second-level navigation for the reader section, rendered by the admin layout
    when the current controller lives under reader/. %>
<% [
     [ t("reader.nav.entries"), reader_entries_path, reader_entries_path ],
     [ t("reader.nav.clippings"), reader_clippings_path, reader_clippings_path ],
     [ t("reader.nav.feeds"), reader_feeds_path, reader_feeds_path ],
     [ t("reader.nav.categories"), reader_categories_path, reader_categories_path ],
     [ t("reader.nav.newsletters"), reader_newsletters_path, reader_newsletters_path ]
   ].each do |label, path, active_path| %>
  <% active = request.path == active_path || request.path.start_with?("#{active_path}/") %>
  <%= link_to label, path,
        class: "no-underline text-muted hover:text-ink #{'text-ink font-bold' if active}",
        aria: { current: active ? "page" : nil } %>
<% end %>
