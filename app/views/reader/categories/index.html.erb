<section>
  <p class="terminal__prompt mt-0 mb-[0.9rem] text-prompt font-bold text-ink"><%= t("reader.categories.prompt") %></p>

  <p class="mb-6 max-w-measure border-y border-line py-3 text-chrome text-muted">
    <%= t("reader.categories.hint", count: @categories.size) %>
  </p>

  <div class="mb-8 border border-line bg-surface p-4">
    <%= form_with model: @category, url: reader_categories_path, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div class="min-w-[16rem] flex-1">
        <%= form.label :name, t("reader.categories.form.name"), class: "mb-1 block text-chrome text-muted" %>
        <%= form.text_field :name, required: true, placeholder: t("reader.categories.form.name_placeholder"),
              class: "w-full rounded-frame border border-line-strong bg-paper px-3 py-[0.35rem] font-mono text-form text-ink focus:border-ruby focus:outline-none" %>
      </div>
      <%= form.submit t("reader.categories.form.submit"),
            class: "btn btn--primary" %>
    <% end %>

    <p class="mt-3 mb-0 text-meta text-muted"><%= t("reader.categories.form.hint") %></p>
  </div>

  <% if @categories.empty? %>
    <p class="text-prompt text-muted"><%= t("reader.categories.empty") %></p>
  <% else %>
    <ol class="m-0 list-none p-0">
      <% @categories.each do |category| %>
        <li class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line py-[0.7rem] last:border-b">
          <%= form_with model: category, url: reader_category_path(category), method: :patch,
                id: dom_id(category, :rename), class: "flex min-w-[16rem] flex-1 items-center" do |form| %>
            <%= form.text_field :name,
                  class: "w-full min-w-0 rounded-frame border border-line-strong bg-paper px-3 py-[0.35rem] font-mono text-form text-ink focus:border-ruby focus:outline-none" %>
          <% end %>

          <%# Fixed width so the count column lines up regardless of digit count. %>
          <span class="w-[5rem] shrink-0 text-right text-meta text-muted">
            <%= t("reader.categories.feed_count", count: @feed_counts[category.id].to_i) %>
          </span>

          <%# Submit lives outside the form but points at it, so the order reads
              "count, save, remove" while the button still submits the rename. %>
          <%= submit_tag t("reader.categories.actions.rename"),
                form: dom_id(category, :rename), class: "btn btn--sm btn--neutral shrink-0" %>

          <%= button_to t("reader.categories.actions.remove"), reader_category_path(category), method: :delete,
                data: { confirm: t("reader.categories.actions.confirm_remove",
                                   name: category.name, count: @feed_counts[category.id].to_i) },
                class: "btn btn--sm btn--danger shrink-0",
                form: { class: "m-0" } %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
