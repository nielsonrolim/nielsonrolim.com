<%# One clipped story: source and summary state on top, both language editions
    below, then the row of actions. `position` is the number shown in the
    queue (restarting inside each group). %>
<li class="border-t border-line py-4.5">
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-meta text-muted">
    <span class="text-ruby"><%= format("%02d", position) %></span>
    <% if clipping.display_source.present? %>
      <span><%= clipping.display_source %></span>
    <% else %>
      <span><%= t("reader.clippings.manual") %></span>
    <% end %>
    <span><%= t("reader.clippings.marked_at", time: l(clipping.created_at, format: :long)) %></span>
    <%= render "reader/clippings/summary_status", clipping: clipping %>

    <% if clipping.partial_summary_source? && clipping.summarized? %>
      <span class="chip chip--err"><%= t("reader.clippings.partial_summary_source") %></span>
    <% end %>

    <% if clipping.deferred? %>
      <span class="chip chip--warn"><%= t("reader.clippings.deferred_chip") %></span>
    <% end %>

    <%# The languages the story is published in, one or both. A translation
        without a URL of its own does not count. %>
    <% if clipping.languages.any? %>
      <span class="chip chip--ok"><%= clipping.languages.join(" · ") %></span>
    <% else %>
      <span class="chip"><%= t("reader.clippings.language_pending") %></span>
    <% end %>
  </div>

  <% if clipping.primary_variant&.summary.blank? && clipping.summary_error.present? %>
    <p class="mt-2 mb-0 max-w-measure text-meta text-err"><%= clipping.summary_error %></p>
  <% end %>

  <%# Both languages side by side: a published edition has its own URL,
      a translation does not and falls back to the edition that exists. %>
  <div class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 narrow:grid-cols-2">
    <% Clipping::LANGUAGES.each do |locale| %>
      <% variant = clipping.variant_for(locale) %>
      <div class="border-l border-line pl-3">
        <p class="m-0 text-meta text-muted">
          <span class="text-ruby"><%= locale %></span>
          <% if variant.present? %>
            &middot; <%= t("reader.clippings.#{variant.url.present? ? 'published' : 'translation'}") %>
          <% end %>
        </p>

        <h2 class="mt-0.5 mb-1 text-base font-bold text-ink">
          <%= link_to clipping.title_for(locale), safe_url(clipping.url_for(locale)), target: "_blank", rel: "noopener noreferrer",
                class: "text-ink no-underline hover:text-ruby" %>
        </h2>

        <% summary = clipping.summary_for(locale) %>
        <% if summary.present? %>
          <p class="mt-0 mb-0 text-prompt text-ink-soft"><%= summary %></p>
        <% end %>

        <% if variant.nil? && clipping.languages.any? %>
          <p class="mt-1 mb-0 text-meta text-muted"><%= t("reader.clippings.translation_pending") %></p>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-3 text-chrome">
    <%= link_to t("reader.clippings.actions.edit"), edit_reader_clipping_path(clipping),
          class: "btn btn--sm btn--neutral" %>

    <% if clipping.failed? %>
      <%= button_to t("reader.clippings.actions.generate_summary"), generate_summary_reader_clipping_path(clipping), method: :post,
            class: "btn btn--sm btn--primary",
            form: { class: "m-0 inline" },
            data: (clipping.variants.any?(&:manual?) ? { confirm: t("reader.clippings.actions.confirm_overwrite_summary") } : {}) %>
    <% end %>

    <%# Deferring keeps the clipping in the queue but out of the next issue;
        resuming puts it back in the running. %>
    <% if clipping.deferred? %>
      <%= button_to t("reader.clippings.actions.resume"), resume_reader_clipping_path(clipping), method: :patch,
            class: "btn btn--sm btn--neutral",
            form: { class: "m-0 inline" } %>
    <% else %>
      <%= button_to t("reader.clippings.actions.defer"), defer_reader_clipping_path(clipping), method: :patch,
            class: "btn btn--sm btn--neutral",
            form: { class: "m-0 inline" } %>
    <% end %>

    <%= button_to t("reader.clippings.actions.remove"), reader_clipping_path(clipping), method: :delete,
          data: { confirm: t("reader.clippings.actions.confirm_remove", title: clipping.display_title) },
          class: "btn btn--sm btn--danger",
          form: { class: "m-0 inline" } %>
  </div>
</li>
