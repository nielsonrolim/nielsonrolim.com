<section>
  <p class="terminal__prompt mt-0 mb-[0.9rem] text-prompt font-bold text-ink"><%= t("reader.clippings.edit.prompt") %></p>

  <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-line pb-4 text-chrome">
    <span class="text-muted">
      <%= t("reader.clippings.edit.status",
            status: t("reader.clippings.summary_status.#{@clipping.summary_status}")) %>
    </span>
    <% if @clipping.summary_error.present? %>
      <span class="text-err"><%= @clipping.summary_error %></span>
    <% end %>

    <div class="ml-auto flex flex-wrap items-center gap-2">
      <%# Re-fetches the page to refresh the stored text, useful after an
          extraction fix or when the first fetch came in incomplete. %>
      <% if @clipping.primary_variant&.url.present? %>
        <%= button_to t("reader.clippings.actions.refetch_source"), refetch_source_reader_clipping_path(@clipping), method: :post,
              class: "btn btn--sm btn--neutral",
              form: { class: "m-0 inline" } %>
      <% end %>

      <%# Runs the summary and the translation on demand, from whatever source the
          clipping has now (pasted text included). Overwrites a hand-edited
          summary, so it asks first when there is one. %>
      <%= button_to t("reader.clippings.actions.generate_summary"), generate_summary_reader_clipping_path(@clipping), method: :post,
            class: "btn btn--sm btn--primary",
            form: { class: "m-0 inline" },
            data: (@clipping.variants.any?(&:manual?) ? { confirm: t("reader.clippings.actions.confirm_overwrite_summary") } : {}) %>
    </div>
  </div>

  <div class="max-w-measure">
    <%= form_with model: @clipping, url: reader_clipping_path(@clipping), class: "grid gap-6" do |form| %>
      <fieldset class="m-0 border-0 p-0">
        <legend class="mb-1 flex flex-wrap items-center gap-2 text-chrome text-muted">
          <span><%= t("reader.clippings.edit.content") %></span>
          <% if @clipping.languages.any? %>
            <span class="chip chip--ok"><%= @clipping.languages.join(" · ") %></span>
          <% else %>
            <span class="chip"><%= t("reader.clippings.language_pending") %></span>
          <% end %>
        </legend>
        <p class="mt-0 mb-3 text-meta text-muted"><%= t("reader.clippings.edit.content_hint") %></p>

        <div class="grid grid-cols-1 gap-x-6 gap-y-5 narrow:grid-cols-2">
          <% Clipping::LANGUAGES.each do |locale| %>
            <% suffix = SupportedLanguages.param_key(locale) %>
            <% variant = @clipping.stored_variant(locale) %>
            <div class="grid gap-3 border-l border-line pl-3">
              <p class="m-0 text-meta text-ruby"><%= locale %></p>

              <div>
                <%= label_tag "clipping_url_#{suffix}", t("reader.clippings.edit.url"),
                      class: "mb-1 block text-meta text-muted" %>
                <%= url_field_tag "clipping[url_#{suffix}]", variant&.url,
                      class: "w-full rounded-frame border border-line-strong bg-paper px-3 py-[0.3rem] font-mono text-form text-ink focus:border-ruby focus:outline-none" %>
                <p class="mt-1 mb-0 text-meta text-muted"><%= t("reader.clippings.edit.url_hint") %></p>
              </div>

              <div>
                <%= label_tag "clipping_title_#{suffix}", t("reader.clippings.edit.title"),
                      class: "mb-1 block text-meta text-muted" %>
                <%= text_field_tag "clipping[title_#{suffix}]", variant&.title,
                      class: "w-full rounded-frame border border-line-strong bg-paper px-3 py-[0.3rem] font-mono text-form text-ink focus:border-ruby focus:outline-none" %>
              </div>

              <div>
                <%= label_tag "clipping_summary_#{suffix}", t("reader.clippings.edit.summary"),
                      class: "mb-1 block text-meta text-muted" %>
                <%= text_area_tag "clipping[summary_#{suffix}]", variant&.summary, rows: 8,
                      class: "w-full rounded-frame border border-line-strong bg-paper px-3 py-[0.3rem] font-mono text-form text-ink focus:border-ruby focus:outline-none" %>
              </div>
            </div>
          <% end %>
        </div>
      </fieldset>

      <div>
        <%= form.label :source_text, t("reader.clippings.edit.source_text"), class: "mb-1 block text-chrome text-muted" %>
        <%= form.text_area :source_text, rows: 6,
              class: "w-full rounded-frame border border-line-strong bg-paper px-3 py-[0.35rem] font-mono text-form text-ink focus:border-ruby focus:outline-none" %>
        <p class="mt-1 mb-0 text-meta text-muted"><%= t("reader.clippings.edit.source_text_hint") %></p>
      </div>

      <div class="flex items-center gap-4">
        <%= form.submit t("reader.clippings.edit.save"),
              class: "btn btn--primary" %>
        <%= link_to t("reader.clippings.edit.cancel"), reader_clippings_path,
              class: "text-chrome text-muted no-underline hover:text-ink" %>
      </div>
    <% end %>
  </div>
</section>
