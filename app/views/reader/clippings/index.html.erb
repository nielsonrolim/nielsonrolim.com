<section>
  <h1 class="mt-0 mb-3.5 text-prompt font-bold text-ink">
    <span class="terminal__prompt" aria-hidden="true"><%= t("reader.clippings.prompt") %></span>
    <span class="sr-only"><%= t("reader.clippings.title") %></span>
  </h1>

  <p class="mb-6 max-w-measure border-y border-line py-3 text-chrome text-muted">
    <%= t("reader.clippings.hint", count: @shippable_count) %>
    <% if @failed_count.positive? %>
      <span class="text-err"><%= t("reader.clippings.failed_in_queue", count: @failed_count) %></span>
    <% end %>
    <% if @deferred_clippings.any? %>
      <span class="text-muted"><%= t("reader.clippings.deferred_in_queue", count: @deferred_clippings.size) %></span>
    <% end %>
    <%= link_to t("reader.clippings.view_issues"), reader_newsletters_path, class: "text-ruby" %>
  </p>

  <div class="mb-8 border border-line bg-surface p-4">
    <%= form_with model: @clipping, url: reader_clippings_path, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div class="min-w-[16rem] flex-1">
        <%= form.label :url, t("reader.clippings.form.url"), class: "mb-1 block text-chrome text-muted" %>
        <%= form.url_field :url, required: true, placeholder: t("reader.clippings.form.url_placeholder"),
              class: "field focus:border-ruby" %>
      </div>
      <div class="min-w-[14rem]">
        <%= form.label :title, t("reader.clippings.form.title"), class: "mb-1 block text-chrome text-muted" %>
        <%= form.text_field :title, placeholder: t("reader.clippings.form.title_placeholder"),
              class: "field focus:border-ruby" %>
      </div>
      <%= form.submit t("reader.clippings.form.submit"),
            class: "btn btn--primary" %>
    <% end %>

    <p class="mt-3 mb-0 text-meta text-muted"><%= t("reader.clippings.form.hint") %></p>
  </div>

  <% if @active_clippings.empty? && @deferred_clippings.empty? %>
    <p class="text-prompt text-muted"><%= t("reader.clippings.empty") %></p>
  <% else %>
    <% if @active_clippings.any? %>
      <%# The queue in the order it will ship. The dividing rule closes under the
          last item unless the deferred group below brings its own heading rule. %>
      <ol class="m-0 list-none p-0<%= " border-b border-line" if @deferred_clippings.empty? %>">
        <% @active_clippings.each_with_index do |clipping, index| %>
          <%= render "reader/clippings/clipping", clipping: clipping, position: index + 1 %>
        <% end %>
      </ol>
    <% end %>

    <% if @deferred_clippings.any? %>
      <%# The heading carries the single rule between the two groups, so the
          first deferred item drops its own top border to avoid stacking two
          lines (and keeps the rule when the active queue is empty). %>
      <h2 class="<%= @active_clippings.any? ? "mt-8" : "mt-0" %> border-t border-line pt-5 text-chrome font-bold text-muted">
        <%= t("reader.clippings.deferred_heading") %>
      </h2>

      <ol class="m-0 list-none border-b border-line p-0 [&>li:first-child]:border-t-0">
        <% @deferred_clippings.each_with_index do |clipping, index| %>
          <%= render "reader/clippings/clipping", clipping: clipping, position: index + 1 %>
        <% end %>
      </ol>
    <% end %>
  <% end %>
</section>
