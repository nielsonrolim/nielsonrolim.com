<%# Summary generation state for one clipping. %>
<% badge = {
     "summarized" => "chip--ok",
     "summarizing" => nil,
     "pending" => nil,
     "failed" => "chip--err"
   }[clipping.summary_status] %>
<span class="chip <%= badge %>">
  <%= t("reader.clippings.summary_status.#{clipping.summary_status}") %>
</span>
