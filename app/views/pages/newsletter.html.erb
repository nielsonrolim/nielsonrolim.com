<% content_for :title, "#{t('newsletters.title')} — #{t('pages.home.title')}" %>
<% content_for :description, t('newsletters.presentation') %>
<% content_for :translated, true %>

<section class="mt-2 max-w-measure">
  <h2 class="mt-0 mb-3.5 text-prompt font-bold text-ink">
    <span class="terminal__prompt" aria-hidden="true"><%= t("pages.newsletter.prompt") %></span>
    <span class="sr-only"><%= t("pages.newsletter.heading") %></span>
  </h2>
  <h3 class="mt-px mb-3.5 text-lead font-bold text-ink"><%= t("newsletters.title") %></h3>

  <p class="mt-0 mb-6 text-prompt text-ink-soft"><%= t("newsletters.presentation") %></p>

  <%= render "subscribe_form", source: "newsletter" %>

  <p class="mt-8 text-chrome">
    <%= link_to t("pages.newsletter.back"), home_path(locale: I18n.locale), class: "text-muted" %>
  </p>
</section>
