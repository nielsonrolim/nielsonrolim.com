<section class="max-w-measure">
  <p class="terminal__prompt mt-0 mb-3.5 text-prompt font-bold text-ink"><%= t("auth.passwords.new.prompt") %></p>
  <h1 class="mt-px mb-6 text-lead font-bold text-ink"><%= t("auth.passwords.new.title") %></h1>

  <p class="mb-6 text-prompt text-muted"><%= t("auth.passwords.new.instructions") %></p>

  <%= form_with url: passwords_path, class: "grid gap-6" do |form| %>
    <div>
      <%= form.label :email_address, t("auth.passwords.new.email"), class: "mb-1 block text-chrome text-muted" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "field focus:border-ruby" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit t("auth.passwords.new.submit"), class: "btn btn--primary" %>
      <%= link_to t("auth.passwords.new.back"), new_session_path, class: "text-chrome text-muted no-underline hover:text-ink" %>
    </div>
  <% end %>
</section>
